{
    "name": "miran/mks-support-chat",
    "description": "Filament-backed live support chat for Laravel. Visitor widget plus an admin inbox — no mobile app, no multi-site tabs.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "chat", "support", "live-chat"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "filament/filament": "^4.0|^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Miran\\SupportChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Miran\\SupportChat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Miran\\SupportChat\\SupportChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
